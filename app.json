{
  "expo": {
    "name": "قرآن",
    "slug": "Quran",
    "version": "0.3.16",
    "orientation": "portrait",
    "icon": "./assets/images/iconwioutext.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alquran.quran",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/iconwioutext.png",
        "backgroundColor": "#065F46"
      },
      "package": "alquranapp.quran.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم هذا التطبيق الموقع لتحديد اتجاه القبلة بدقة."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "blockedPermissions": [
              "android.permission.ACTIVITY_RECOGNITION"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a8b1b0ef-7931-4aa1-8626-f8b2ebb8b4c2"
      }
    },
    "owner": "kamkmgamer"
  }
}
